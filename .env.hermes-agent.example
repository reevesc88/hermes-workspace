# hermes-agent gateway / CLI env — PLACEHOLDER TEMPLATE
#
# This file is NOT read by hermes-workspace itself. It documents the
# variables the hermes-agent gateway and CLI need in their own env file,
# so the workspace has something to talk to.
#
# Location this template gets copied to:
#   macOS / Linux : ~/.hermes/.env
#                   (or the path `hermes config env-path` reports, if the
#                   hermes CLI is installed and that differs)
#   Windows       : gateway  -> %LOCALAPPDATA%\hermes\.env
#                   CLI      -> %USERPROFILE%\.hermes\.env
#                   (two separate files on Windows — see docs/windows-setup-guide.md)
#
# scripts/setup.sh copies this file automatically if the target doesn't
# already exist. It never overwrites an existing file.
#
# After copying, fill in real values and keep the result OUT of git. This
# template must only ever contain placeholders — never a real key.

# ─── LLM provider — pick at least one ───────────────────────────────────────
# Usually set via `hermes setup` instead of by hand. Uncomment and fill in
# only the provider(s) you actually use.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here

# ─── Gateway HTTP API (required for hermes-workspace to see sessions,
#     memory, skills, jobs) ──────────────────────────────────────────────────
# Opt-in: without this the gateway serves messaging platforms only, not :8642.
API_SERVER_ENABLED=true

# 127.0.0.1 for local-only. 0.0.0.0 to expose to other devices (Tailscale/LAN) —
# only do this together with API_SERVER_KEY set below.
API_SERVER_HOST=127.0.0.1

# Required once API_SERVER_HOST is not loopback-only. Generate with:
#   openssl rand -hex 32
# The SAME value must be set as HERMES_API_TOKEN in the workspace .env.
# API_SERVER_KEY=REPLACE_WITH_RANDOM_HEX_STRING
